menu "Time Sync Configuration"

    config TIME_SYNC_REQUEST_MSG_TYPE
        hex "Time sync request message type"
        default 0x20
        range 0x01 0x3F
        help
            UART message type for time sync requests sent by the target
            (command class range 0x01..0x3F).

    config TIME_SYNC_RESPONSE_MSG_TYPE
        hex "Time sync response message type"
        default 0x60
        range 0x40 0x7F
        help
            UART message type for time sync responses sent by the host
            (response class range 0x40..0x7F).

endmenu
