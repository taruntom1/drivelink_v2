menu "Rotary Encoder HAL Configuration"

    config ENCODER_HAL_GLITCH_FILTER_NS
        int "Glitch filter width in nanoseconds"
        default 1000
        range 0 10000
        help
            Hardware glitch filter duration for PCNT input signals.
            Pulses shorter than this value are rejected by the hardware.
            Set to 0 to disable the glitch filter entirely.
            1000 ns (1 us) is a good default for mechanical rotary encoders.

    config ENCODER_HAL_RATE_SAMPLE_PERIOD_MS
        int "Rate sampling period in milliseconds"
        default 50
        range 10 1000
        help
            Minimum time between on-demand rate samples.
            Rate/direction are recalculated when getRate()/getDirection()
            are called and at least this much time has elapsed.
            Shorter periods give faster response but noisier rate readings.
            Longer periods give smoother readings but slower response.
            50 ms (20 Hz) provides a good balance for motor control.

    config ENCODER_HAL_PCNT_HIGH_LIMIT
        int "PCNT counter high limit"
        default 32767
        range 100 32767
        help
            Upper limit for the 16-bit PCNT hardware counter.
            When reached, the counter wraps and the accumulator tracks the overflow.
            Use the maximum (32767) to minimize overflow interrupt frequency.

    config ENCODER_HAL_PCNT_LOW_LIMIT
        int "PCNT counter low limit"
        default -32768
        range -32768 -100
        help
            Lower limit for the 16-bit PCNT hardware counter.
            When reached, the counter wraps and the accumulator tracks the overflow.
            Use the minimum (-32768) to minimize overflow interrupt frequency.

endmenu
