menu "Diagnostics (diag)"

    config DIAG_EVENT_MSG_TYPE
        hex "Diag event message type"
        default 0xC0
        range 0xC0 0xFE
        help
            UART message type for diag events sent by the target (Record,
            CounterDelta, Cleared, Boot). Event class range 0xC0..0xFE.

    config DIAG_QUERY_MSG_TYPE
        hex "Diag query message type"
        default 0x23
        range 0x01 0x3F
        help
            UART message type for diag queries sent by the host (GetInfo,
            GetEntries, Clear). Command class range 0x01..0x3F.

    config DIAG_QUERY_RESPONSE_MSG_TYPE
        hex "Diag query response message type"
        default 0x63
        range 0x40 0x7F
        help
            UART message type for diag query responses sent by the target.
            Response class range 0x40..0x7F.

    config DIAG_RECORD_QUEUE_DEPTH
        int "Record queue depth"
        default 16
        range 4 128
        help
            Records and Cleared events waiting to be sent. It also holds the
            records reported during startup, before the reporter runs. A
            full queue drops the new record and counts diag.RecordDropped.
            Static storage: about 32 bytes per entry.

    config DIAG_QUERY_QUEUE_DEPTH
        int "Query queue depth"
        default 2
        range 1 8
        help
            Host queries waiting for the reporter task. A full queue drops
            the query and counts diag.QueryDropped.

    config DIAG_COUNTER_PERIOD_MS
        int "Counter delta period (ms)"
        default 1000
        range 100 60000
        help
            How often changed counters are sent as CounterDelta events.
            A counter that did not change sends nothing.

    config DIAG_REPORTER_POLL_MS
        int "Reporter poll period (ms)"
        default 20
        range 10 1000
        help
            How often the reporter task checks the record queue. Queries
            wake it immediately; records wait at most this long.

    config DIAG_TASK_STACK
        int "Reporter task stack size"
        default 4096
        range 2048 16384
        help
            Stack size in bytes for the diag reporter task.

    config DIAG_TASK_PRIO
        int "Reporter task priority"
        default 4
        range 1 24
        help
            FreeRTOS priority of the diag reporter task. Keep it below the
            control and sampling tasks.

    config DIAG_CONSOLE_LOG
        bool "Also log diag reports as console text"
        default y
        help
            When enabled, DIAG_ERROR / DIAG_WARN also print a console line
            (ESP_LOGE / ESP_LOGW). When disabled, the text part compiles to
            nothing (no format strings in the binary, arguments not
            evaluated), and the first-party components (components/ and
            main/) are built with LOG_LOCAL_LEVEL=ESP_LOG_NONE, so their
            remaining ESP_LOGx calls are removed too. ESP-IDF's own logs
            follow CONFIG_LOG_DEFAULT_LEVEL as usual. Codes are still sent
            over the UART either way.

endmenu
