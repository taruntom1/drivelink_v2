menu "PID Controller Configuration"

    config PID_DEFAULT_OUTPUT_MIN
        int "Default output minimum (x1000)"
        default -1000
        range -100000 0
        help
            Default lower output limit, scaled by 1000.
            -1000 represents -1.0 (full reverse).
            Can be overridden per-instance via PidConfig::output_min.

    config PID_DEFAULT_OUTPUT_MAX
        int "Default output maximum (x1000)"
        default 1000
        range 0 100000
        help
            Default upper output limit, scaled by 1000.
            1000 represents 1.0 (full forward).
            Can be overridden per-instance via PidConfig::output_max.

    config PID_DEFAULT_DERIVATIVE_CUTOFF_HZ
        int "Default derivative filter cutoff (Hz)"
        default 0
        range 0 10000
        help
            Cutoff frequency of the first-order low-pass filter on the
            derivative term. 0 disables the filter (raw derivative).
            Because it is a frequency rather than a per-sample coefficient,
            the filter behaves the same at any loop rate.
            Can be overridden per-instance via PidConfig::derivative_cutoff_hz.

endmenu
