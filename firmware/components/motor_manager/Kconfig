menu "Motor Manager Configuration"

    config MOTOR_MANAGER_CONFIGURE_MSG_TYPE
        hex "Configure command message type"
        default 0x21
        range 0x01 0x3F
        help
            UART message type used for motor manager configure requests
            (command class range 0x01..0x3F).

    config MOTOR_MANAGER_CONFIGURE_RESPONSE_MSG_TYPE
        hex "Configure response message type"
        default 0x61
        range 0x40 0x7F
        help
            UART message type used for motor manager configure responses
            (response class range 0x40..0x7F).

    config MOTOR_MANAGER_SETPOINT_STREAM_CHANNEL
        hex "Setpoint stream channel"
        default 0x80
        range 0x80 0xBF
        help
            UART stream channel for setpoint data from host to target
            (stream class range 0x80..0xBF).

    config MOTOR_MANAGER_TELEMETRY_STREAM_CHANNEL
        hex "Telemetry stream channel"
        default 0x81
        range 0x80 0xBF
        help
            UART stream channel for telemetry data from target to host
            (stream class range 0x80..0xBF).

    config MOTOR_MANAGER_USE_MOCK_FEEDBACK
        bool "Use setpoint-backed mock telemetry"
        default n
        help
            Enables a hardware-free mock mode for motor_manager. In this mode,
            motor setpoints are echoed as telemetry feedback values without
            creating real motor_controller instances.

    config MOTOR_MANAGER_DEFAULT_UPDATE_TASK_STACK
        int "Default motor manager control task stack size"
        default 4096
        range 2048 16384
        help
            Stack size in bytes for the optional internal control (update)
            task that runs the motor control loop and publishes telemetry.

    config MOTOR_MANAGER_DEFAULT_UPDATE_TASK_PRIO
        int "Default motor manager control task priority"
        default 20
        range 1 24
        help
            FreeRTOS priority for the optional internal control task. It is
            woken by an esp_timer callback, so keep it high (but below the
            esp_timer task, priority 22) to keep wake-up jitter low.

    config MOTOR_MANAGER_DEFAULT_CONTROL_TASK_CORE
        int "Default motor manager control task core (-1 = no affinity)"
        default 1
        range -1 1
        help
            Core the control task is pinned to. Core 1 keeps it away from the
            UART RX and config work, which typically runs on core 0.

    config MOTOR_MANAGER_DEFAULT_CONTROL_PERIOD_US
        int "Default control loop period (us)"
        default 1000
        range 250 100000
        help
            Period of the esp_timer that drives the motor control loop. The
            host can change it at runtime with the SetTiming subcommand.
            The loop does not depend on CONFIG_FREERTOS_HZ.

    config MOTOR_MANAGER_DEFAULT_TELEMETRY_PERIOD_US
        int "Default telemetry period (us)"
        default 10000
        range 250 1000000
        help
            Telemetry is published every N control ticks, where N is this
            period divided by the control period, rounded up. The host can
            change it at runtime with the SetTiming subcommand.

    config MOTOR_MANAGER_LOG_LOOP_STATS
        bool "Log control loop timing statistics"
        default n
        help
            Every 5 s, log the min/mean/max interval between control loop
            runs and the min/mean/max time spent in one run. Useful for
            checking jitter on hardware.

    config MOTOR_MANAGER_DEFAULT_CONFIG_TASK_STACK
        int "Default motor manager config task stack size"
        default 4096
        range 2048 16384
        help
            Stack size in bytes for the internal configuration command task.
            This task parses and dispatches queued configure commands.

    config MOTOR_MANAGER_DEFAULT_CONFIG_TASK_PRIO
        int "Default motor manager config task priority"
        default 6
        range 1 24
        help
            FreeRTOS priority for the internal configuration command task.

    config MOTOR_MANAGER_CONFIG_QUEUE_DEPTH
        int "Configure command queue depth"
        default 8
        range 1 32
        help
            Number of configure frames the UART RX callback can queue for the
            config task. A full queue drops the command (logged).

    config MOTOR_MANAGER_MUTEX_TIMEOUT_MS
        int "Manager mutex timeout (ms)"
        default 50
        range 1 1000
        help
            How long configure commands and the manual update/telemetry API
            wait for the manager mutex before failing with INTERNAL_ERROR.
            The control tick never waits: it only try-locks.

endmenu
