menu "Time Sync Configuration"

    config TIME_SYNC_REQUEST_MSG_TYPE
        hex "Time sync request message type"
        default 0x20
        range 0x01 0x3F
        help
            UART message type for time sync requests sent by the target
            (command class range 0x01..0x3F).

    config TIME_SYNC_RESPONSE_MSG_TYPE
        hex "Time sync response message type"
        default 0x60
        range 0x40 0x7F
        help
            UART message type for time sync responses sent by the host
            (response class range 0x40..0x7F).

    config TIME_SYNC_TASK_STACK
        int "Periodic sync task stack size"
        default 4096
        range 2048 16384
        help
            Default stack size in bytes for the periodic sync task
            (TimeSyncConfig::task_stack_size).

    config TIME_SYNC_TASK_PRIO
        int "Periodic sync task priority"
        default 6
        range 1 24
        help
            Default FreeRTOS priority for the periodic sync task
            (TimeSyncConfig::task_priority).

endmenu
