menu "UART Comm Configuration"

    config UART_COMM_PORT_NUM
        int "UART port number"
        default 1
        range 0 2
        help
            Which UART peripheral to use (0, 1, or 2).
            UART 0 is typically used for console logging.

    config UART_COMM_MAX_PAYLOAD
        int "Maximum payload size in bytes"
        default 1024
        range 128 1024
        help
            Largest payload this firmware sends or accepts per frame. The
            protocol limit is 1024 (drivelink::protocol::kMaxPayload); a
            build may use a smaller receive limit, never a larger one.
            Sizes RxFrame (and every queue of RxFrames), the command buffer
            pool and the scanner window.

    config UART_COMM_RX_BUF_SIZE
        int "UART RX ring buffer size"
        default 4096
        range 256 8192
        help
            Size of the UART driver receive ring buffer in bytes.
            4096 bytes hold about 44 ms of traffic at 921600 baud.

    config UART_COMM_TX_BUF_SIZE
        int "UART TX ring buffer size"
        default 4096
        range 0 8192
        help
            Size of the UART driver transmit ring buffer in bytes.
            Set to 0 for blocking TX mode. Keep it above one full frame
            (MAX_PAYLOAD + 9 bytes), or uart_write_bytes() blocks the TX
            task part-way through each large frame.

    config UART_COMM_CMD_QUEUE_DEPTH
        int "TX command queue depth"
        default 8
        range 2 32
        help
            Number of command/response/event frames that can be
            queued for transmission before sendCommand returns an error.

    config UART_COMM_RX_QUEUE_DEPTH
        int "RX delivery queue depth"
        default 8
        range 2 32
        help
            Number of received frames buffered for the application
            to consume via receive().

    config UART_COMM_RX_TASK_STACK
        int "RX task stack size"
        default 4096
        range 2048 16384
        help
            Stack size in bytes for the internal receive task.

    config UART_COMM_RX_TASK_PRIO
        int "RX task priority"
        default 5
        range 1 24
        help
            FreeRTOS priority for the internal receive task.

    config UART_COMM_TX_TASK_STACK
        int "TX task stack size"
        default 4096
        range 2048 16384
        help
            Stack size in bytes for the internal transmit task.

    config UART_COMM_TX_TASK_PRIO
        int "TX task priority"
        default 5
        range 1 24
        help
            FreeRTOS priority for the internal transmit task.

    config UART_COMM_EVENT_QUEUE_SIZE
        int "UART driver event queue size"
        default 20
        range 5 100
        help
            Length of the UART driver's event queue. Events only wake the
            RX task and report errors; received bytes are read straight from
            the ring buffer, so a full event queue does not lose data.

    config UART_COMM_RX_TIMEOUT_SYMBOLS
        int "RX timeout in symbol periods"
        default 10
        range 1 126
        help
            Number of symbol periods of silence before the UART
            hardware triggers an RX timeout interrupt. One symbol
            is approximately one byte transmission time.

endmenu
