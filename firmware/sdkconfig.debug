# Used only by tools/bench_fw.py in the isolated build_debug directory, for JTAG
# debugging. Off: the stack watchpoint, so GDB has both hardware watchpoints.
# On: heap corruption checks and a compiler stack guard. Slower than normal.
# CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK is not set
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
