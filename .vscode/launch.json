{
  // JTAG debugging with the C/C++ extension (cppdbg). docs/development.md,
  // "JTAG debugging", has the setup. tools/jtag.py picks the matching ELF and
  // writes build/jtag/. The GDB path is ESP-IDF 5.5.2's default install.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "JTAG: start server and attach",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "JTAG server",
      "postDebugTask": "JTAG stop",
      "program": "${workspaceFolder}/build/jtag/firmware.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerServerAddress": "127.0.0.1:23333",
      "windows": {
        "miDebuggerPath": "${userHome}/.espressif/tools/xtensa-esp-elf-gdb/16.3_20250913/xtensa-esp-elf-gdb/bin/xtensa-esp32s3-elf-gdb.exe"
      },
      "linux": {
        "miDebuggerPath": "${userHome}/.espressif/tools/xtensa-esp-elf-gdb/16.3_20250913/xtensa-esp-elf-gdb/bin/xtensa-esp32s3-elf-gdb"
      },
      "setupCommands": [
        { "text": "source ${workspaceFolder}/build/jtag/init.gdb" }
      ]
    },
    {
      "name": "JTAG: attach to a running server",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/jtag/firmware.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerServerAddress": "127.0.0.1:23333",
      "windows": {
        "miDebuggerPath": "${userHome}/.espressif/tools/xtensa-esp-elf-gdb/16.3_20250913/xtensa-esp-elf-gdb/bin/xtensa-esp32s3-elf-gdb.exe"
      },
      "linux": {
        "miDebuggerPath": "${userHome}/.espressif/tools/xtensa-esp-elf-gdb/16.3_20250913/xtensa-esp-elf-gdb/bin/xtensa-esp32s3-elf-gdb"
      },
      "setupCommands": [
        { "text": "source ${workspaceFolder}/build/jtag/init.gdb" }
      ]
    }
  ]
}
